# ================================================================
#  .env.example  —  copy to .env for local dev
#  On Railway: set these in the Railway dashboard under Variables
#  NEVER commit .env to git
# ================================================================

# ── Server ──────────────────────────────────────────────────────
PORT=4000

# ── Frontend URL (your Railway domain after deploy)
# Used for CORS. During local dev keep as http://localhost:5173
# On Railway set to: https://your-app-name.railway.app
FRONTEND_URL=http://localhost:5173

# ── MQTT — HiveMQ Cloud free tier (replaces public broker)
# Sign up free at: https://www.hivemq.com/mqtt-cloud-broker/
# Format: mqtts://your-cluster-id.s1.eu.hivemq.cloud
MQTT_BROKER=mqtts://your-cluster.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=your-hivemq-username
MQTT_PASS=your-hivemq-password

# ── Auth — change ALL THREE before going live
ADMIN_PASSWORD=admin123
OPERATOR_PASSWORD=operator123
VIEWER_PASSWORD=viewer123

# ── JWT — generate a long random string, never share it
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# ── Data storage
# On Railway: mount a volume at /data and set DB_FILE=/data/dashboard_data.json
# Locally: ./data/dashboard_data.json
DB_FILE=./data/dashboard_data.json
